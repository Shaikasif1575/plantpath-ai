# Production mode. No simulated predictions.
DEMO_MODE=false

# Connected verified classifier (no retraining performed by this project).
# EfficientNetV2-S, 38 PlantVillage classes — see models/classifier_audit.json
# and tests/verify_new_model.py for the verification gate.
MODEL_PATH=models/efficientnet_v2_s_best.pth
MODEL_CLASSES_PATH=data/model_classes.json
MODEL_AUDIT_PATH=models/classifier_audit.json
PREPROCESSING=imagenet_normalized

# Segmentation model for severity. Unset = severity reported as unavailable.
# Severity is never derived from classifier confidence.
SEGMENTATION_MODEL_PATH=models/segmentation_model

CLASS_NAMES_PATH=data/class_names.json
MODEL_METRICS_PATH=data/model_metrics.json
DISEASES_PATH=data/diseases.json
DB_PATH=backend/app/database/plantpath.db

# Low-confidence threshold for predictions
CONFIDENCE_LOW=0.55
CONFIDENCE_MEDIUM=0.75

MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000